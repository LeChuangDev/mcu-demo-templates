# clangd 配置：复用 ESP-IDF 自动生成的编译数据库，实现跨组件补全、头文件跳转与诊断。
# 编译数据库位于 build/compile_commands.json，首次 idf.py build 时自动生成。
#
# clangd 不是交叉编译器，不会自己去 xtensa 工具链里找标准库头文件。
# 这里直接把工具链的 3 个系统头文件目录告诉它（路径取自
#   xtensa-esp32s3-elf-gcc -E -v -xc NUL 的 "search starts here" 列表）：
# 否则 <stdint.h>/<inttypes.h> 找不到，esp_log.h 里的宏会连带报语法错误。
# 换电脑 / 换工具链版本时，只需把下面三行路径改成新工具链的对应目录；
# 也可以先编译一次，再运行 tools/update-clangd.ps1 自动改写。
# --target 必须保留：否则 clangd 会按 x86_64 解析，FreeRTOS 会走到错误的分支。
# 注意：不要再在编辑器参数里加 --query-driver，它和 --target 同时存在时
# 会让 clangd 执行 "gcc --target=..." 提取系统头文件路径并失败。
CompileFlags:
  CompilationDatabase: build
  Add:
    - --target=xtensa-esp-elf
    - -isystemC:/Espressif/tools/xtensa-esp-elf/esp-14.2.0_20260121/xtensa-esp-elf/lib/gcc/xtensa-esp-elf/14.2.0/include
    - -isystemC:/Espressif/tools/xtensa-esp-elf/esp-14.2.0_20260121/xtensa-esp-elf/lib/gcc/xtensa-esp-elf/14.2.0/include-fixed
    - -isystemC:/Espressif/tools/xtensa-esp-elf/esp-14.2.0_20260121/xtensa-esp-elf/xtensa-esp-elf/include
    - -Wno-unknown-warning-option
  Remove:
    # clang 前缀不认识的 Xtensa / ESP-IDF 专有编译参数
    - -mlongcalls
    - -fno-builtin-memcpy
    - -fno-builtin-memset
    - -fno-builtin-bzero
    - -fno-tree-switch-conversion
    - -fno-shrink-wrap
    - -fno-jump-tables
    - -fstrict-volatile-bitfields
    - -fmacro-prefix-map=*
    - -fdiagnostics-color=*

# IncludeCleaner 在 ESP-IDF 这种"头文件层层转包含"的工程里误报很多
# （会把 driver/gpio.h 里的 esp_err.h、FreeRTOS 的 portmacro.h 之类判成未使用），
# 关掉它，问题面板只保留真正的编译错误/警告。
Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None

# 索引：头文件跳转 / 跨文件跳转的能力来源
#   Background: build  -> 后台建索引并持久化到 .cache/clangd/index（配合 --background-index）
#   StandardLibrary    -> 允许索引标准库符号，Ctrl+点击 stdint.h 里的类型可直接跳转
Index:
  Background: build
  StandardLibrary: true
